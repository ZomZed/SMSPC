[Unit]
Description=Super Mario Sunshine PC port lobby / rendezvous / relay server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=smslobby
Group=smslobby
# Edit the port or options here, then: sudo systemctl daemon-reload && sudo systemctl restart sms-lobby
ExecStart=/usr/bin/python3 -u /opt/sms-lobby/sms_lobby_server.py --port 7700
Restart=always
RestartSec=3
# hardening: no files to write, no privileges needed (port 7700 is above 1024)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_UNIX
MemoryMax=128M

[Install]
WantedBy=multi-user.target
