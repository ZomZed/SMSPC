+// SMS PC port patch (aurora_msaa_depth.patch): D3D12 on AMD can fail CreateGraphicsPipelineState
+// with E_OUTOFMEMORY (Dawn: an Internal error) for the multisampled-texture pipelines, mostly on
+// first compile with other GPU work going on; an uncaptured error is fatal. Capture it, retry
+// with back-off, and return null after 5 failures (the caller skips its work).
+static wgpu::RenderPipeline create_render_pipeline_retry(const wgpu::RenderPipelineDescriptor& descriptor) {
+  for (int attempt = 0;; ++attempt) {
+    g_device.PushErrorScope(wgpu::ErrorFilter::OutOfMemory);
+    g_device.PushErrorScope(wgpu::ErrorFilter::Internal);
+    auto pipeline = g_device.CreateRenderPipeline(&descriptor);
+    wgpu::ErrorType errorType = wgpu::ErrorType::NoError;
+    std::string errorMessage;
+    for (int scope = 0; scope < 2; ++scope) {
+      const auto future = g_device.PopErrorScope(
+          wgpu::CallbackMode::WaitAnyOnly,
+          [&](wgpu::PopErrorScopeStatus status, wgpu::ErrorType type, wgpu::StringView message) {
+            if (status == wgpu::PopErrorScopeStatus::Success && type != wgpu::ErrorType::NoError &&
+                errorType == wgpu::ErrorType::NoError) {
+              errorType = type;
+              errorMessage = std::string{std::string_view{message}};
+            }
+          });
+      webgpu::g_instance.WaitAny(future, UINT64_MAX);
+    }
+    if (errorType == wgpu::ErrorType::NoError) {
+      return pipeline;
+    }
+    if (attempt >= 4) {
+      Log.error("Pipeline '{}' failed after {} attempts: {}", std::string_view{descriptor.label}, attempt + 1,
+                errorMessage);
+      return {};
+    }
+    Log.warn("Pipeline '{}' creation failed (attempt {}), retrying: {}", std::string_view{descriptor.label},
+             attempt + 1, errorMessage);
+    std::this_thread::sleep_for(std::chrono::milliseconds(20 << attempt));
+  }
+}
+
+// SMS PC port patch (aurora_msaa_depth.patch): sample-0 colour snapshot of a multisampled EFB.
+// A compute pass (a render pipeline reading a multisampled float texture failed
+// CreateGraphicsPipelineState with E_OUTOFMEMORY on every attempt on AMD/D3D12) packs sample 0
+// of each pixel into a buffer in the snapshot's byte order; the buffer is then copied into it.
+static constexpr std::string_view ColorSample0Shader = R"(
+struct P { size: vec2u, bgra: u32, rowWords: u32 };
+@group(0) @binding(0) var src: texture_multisampled_2d<f32>;
+@group(0) @binding(1) var<storage, read_write> outp: array<u32>;
+@group(0) @binding(2) var<uniform> p: P;
+
+@compute @workgroup_size(8, 8, 1)
+fn cs_main(@builtin(global_invocation_id) id: vec3u) {
+    if (id.x >= p.size.x || id.y >= p.size.y) { return; }
+    var c = textureLoad(src, vec2i(id.xy), 0);
+    if (p.bgra != 0u) { c = c.bgra; }
+    let b = vec4u(round(clamp(c, vec4f(0.0), vec4f(1.0)) * 255.0));
+    outp[id.y * p.rowWords + id.x] = b.x | (b.y << 8u) | (b.z << 16u) | (b.w << 24u);
+}
+)"sv;
+
+void snapshot_color_sample0(const wgpu::CommandEncoder& cmd, const wgpu::TextureView& srcColor,
+                            const wgpu::Texture& dst, wgpu::TextureFormat format, uint32_t width,
+                            uint32_t height) {
+  const bool bgra = format == wgpu::TextureFormat::BGRA8Unorm || format == wgpu::TextureFormat::BGRA8UnormSrgb;
+  if (!bgra && format != wgpu::TextureFormat::RGBA8Unorm && format != wgpu::TextureFormat::RGBA8UnormSrgb) {
+    Log.warn("sample-0 snapshot: unsupported format {}", static_cast<int>(format));
+    return;
+  }
+  if (!g_colorSample0Layout) {
+    const std::array entries{
+        wgpu::BindGroupLayoutEntry{
+            .binding = 0,
+            .visibility = wgpu::ShaderStage::Compute,
+            .texture =
+                wgpu::TextureBindingLayout{
+                    .sampleType = wgpu::TextureSampleType::UnfilterableFloat,
+                    .viewDimension = wgpu::TextureViewDimension::e2D,
+                    .multisampled = true,
+                },
+        },
+        wgpu::BindGroupLayoutEntry{
+            .binding = 1,
+            .visibility = wgpu::ShaderStage::Compute,
+            .buffer = wgpu::BufferBindingLayout{.type = wgpu::BufferBindingType::Storage},
+        },
+        wgpu::BindGroupLayoutEntry{
+            .binding = 2,
+            .visibility = wgpu::ShaderStage::Compute,
+            .buffer = wgpu::BufferBindingLayout{.type = wgpu::BufferBindingType::Uniform},
+        },
+    };
+    const wgpu::BindGroupLayoutDescriptor descriptor{
+        .label = "Colour Sample0 Bind Group Layout",
+        .entryCount = entries.size(),
+        .entries = entries.data(),
+    };
+    g_colorSample0Layout = g_device.CreateBindGroupLayout(&descriptor);
+    const std::string source{ColorSample0Shader};
+    const wgpu::ShaderSourceWGSL wgslSource{wgpu::ShaderSourceWGSL::Init{.code = source.c_str()}};
+    const wgpu::ShaderModuleDescriptor moduleDescriptor{.nextInChain = &wgslSource, .label = "Colour Sample0"};
+    const wgpu::PipelineLayoutDescriptor layoutDescriptor{
+        .bindGroupLayoutCount = 1,
+        .bindGroupLayouts = &g_colorSample0Layout,
+    };
+    const wgpu::ComputePipelineDescriptor pipelineDescriptor{
+        .label = "Colour Sample0",
+        .layout = g_device.CreatePipelineLayout(&layoutDescriptor),
+        .compute = wgpu::ComputeState{.module = g_device.CreateShaderModule(&moduleDescriptor), .entryPoint = "cs_main"},
+    };
+    g_device.PushErrorScope(wgpu::ErrorFilter::OutOfMemory);
+    g_device.PushErrorScope(wgpu::ErrorFilter::Internal);
+    g_colorSample0Compute = g_device.CreateComputePipeline(&pipelineDescriptor);
+    bool failed = false;
+    for (int scope = 0; scope < 2; ++scope) {
+      const auto future = g_device.PopErrorScope(
+          wgpu::CallbackMode::WaitAnyOnly, [&](wgpu::PopErrorScopeStatus status, wgpu::ErrorType type, wgpu::StringView message) {
+            if (status == wgpu::PopErrorScopeStatus::Success && type != wgpu::ErrorType::NoError) {
+              failed = true;
+              Log.error("sample-0 snapshot pipeline failed: {}", std::string_view{message});
+            }
+          });
+      webgpu::g_instance.WaitAny(future, UINT64_MAX);
+    }
+    if (failed) {
+      g_colorSample0Compute = {};
+    }
+  }
+  if (!g_colorSample0Compute || width == 0 || height == 0) {
+    return;
+  }
+  const uint32_t bytesPerRow = (width * 4 + 255) & ~255u;
+  const uint64_t size = static_cast<uint64_t>(bytesPerRow) * height;
+  if (!g_colorSample0Buffer || g_colorSample0Buffer.GetSize() < size) {
+    const wgpu::BufferDescriptor bufferDescriptor{
+        .label = "Colour Sample0 Buffer",
+        .usage = wgpu::BufferUsage::Storage | wgpu::BufferUsage::CopySrc,
+        .size = size,
+    };
+    g_colorSample0Buffer = g_device.CreateBuffer(&bufferDescriptor);
+  }
+  const uint32_t params[4] = {width, height, bgra ? 1u : 0u, bytesPerRow / 4};
+  const wgpu::BufferDescriptor uniformDescriptor{
+      .label = "Colour Sample0 Params",
+      .usage = wgpu::BufferUsage::Uniform,
+      .size = sizeof(params),
+      .mappedAtCreation = true,
+  };
+  const auto uniform = g_device.CreateBuffer(&uniformDescriptor);
+  std::memcpy(uniform.GetMappedRange(0, sizeof(params)), params, sizeof(params));
+  uniform.Unmap();
+  const std::array bindGroupEntries{
+      wgpu::BindGroupEntry{.binding = 0, .textureView = srcColor},
+      wgpu::BindGroupEntry{.binding = 1, .buffer = g_colorSample0Buffer, .size = size},
+      wgpu::BindGroupEntry{.binding = 2, .buffer = uniform, .size = sizeof(params)},
+  };
+  const wgpu::BindGroupDescriptor bindGroupDescriptor{
+      .layout = g_colorSample0Layout,
+      .entryCount = bindGroupEntries.size(),
+      .entries = bindGroupEntries.data(),
+  };
+  const auto bindGroup = g_device.CreateBindGroup(&bindGroupDescriptor);
+  {
+    const auto pass = cmd.BeginComputePass();
+    pass.SetPipeline(g_colorSample0Compute);
+    pass.SetBindGroup(0, bindGroup);
+    pass.DispatchWorkgroups((width + 7) / 8, (height + 7) / 8);
+    pass.End();
+  }
+  const wgpu::TexelCopyBufferInfo src{
+      .layout = {.offset = 0, .bytesPerRow = bytesPerRow, .rowsPerImage = height},
+      .buffer = g_colorSample0Buffer,
+  };
+  const wgpu::TexelCopyTextureInfo dstInfo{.texture = dst};
+  const wgpu::Extent3D extent{width, height, 1};
+  cmd.CopyBufferToTexture(&src, &dstInfo, &extent);
+}
 
