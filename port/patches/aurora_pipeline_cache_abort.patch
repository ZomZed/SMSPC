     pipeline_cache_abort();
     return false;
   }
+  // SMS PC port patch (aurora_pipeline_cache_abort.patch): a cache corrupted by a crash failed
+  // every read/write (and a failed read crashed below); check it once and start a fresh one.
+  {
+    sqlite3_stmt* check = nullptr;
+    bool healthy = false;
+    if (sqlite3_prepare_v2(g_pipelineCacheDb, "PRAGMA quick_check(1)", -1, &check, nullptr) == SQLITE_OK &&
+        sqlite3_step(check) == SQLITE_ROW) {
+      const auto* text = reinterpret_cast<const char*>(sqlite3_column_text(check, 0));
+      healthy = text != nullptr && std::string_view(text) == "ok";
+    }
+    sqlite3_finalize(check);
+    if (!healthy) {
+      Log.warn("Pipeline cache {} is damaged; moving it to .corrupt and starting a new one", path);
+      sqlite3_close(g_pipelineCacheDb);
+      g_pipelineCacheDb = nullptr;
+      std::remove((path + ".corrupt").c_str());
+      std::rename(path.c_str(), (path + ".corrupt").c_str());
+      std::remove((path + "-wal").c_str());
+      std::remove((path + "-shm").c_str());
+      ret = sqlite3_open(path.c_str(), &g_pipelineCacheDb);
+      if (ret != SQLITE_OK) {
+        Log.error("Failed to open pipeline cache database: {}", sqlite3_errmsg(g_pipelineCacheDb));
+        pipeline_cache_abort();
+        return false;
+      }
+    }
+  }
+
   ret = sqlite::exec(g_pipelineCacheDb, "PRAGMA journal_mode=WAL; PRAGMA synchronous=NORMAL;");
