+  // SMS PC port patch (aurora_efb_floor.patch): the EFB is never rendered below the GameCube's
+  // own resolution in either axis (internal scale < 1, or a widescreen picture in a small
+  // window). Below it, several GameCube pixels share one target pixel and the CPU-read EFB
+  // copies (pollution maps, pixel counts) stop matching the GameCube. Scaled up uniformly.
+  {
+    const auto [floorW, floorH] = vi::configured_fb_size();
+    if (floorW > 0 && floorH > 0 && fb_w > 0 && fb_h > 0 &&
+        (fb_w < static_cast<int>(floorW) || fb_h < static_cast<int>(floorH))) {
+      const double f = std::max(static_cast<double>(floorW) / fb_w, static_cast<double>(floorH) / fb_h);
+      fb_w = std::max(static_cast<int>(floorW), static_cast<int>(std::lround(fb_w * f)));
+      fb_h = std::max(static_cast<int>(floorH), static_cast<int>(std::lround(fb_h * f)));
+    }
+  }
 
