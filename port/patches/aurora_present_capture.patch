+#ifdef AURORA_ENABLE_GX
+// SMS PC port patch (aurora_present_capture.patch), see aurora/gfx.hpp.
+bool aurora::gfx::request_present_capture(PresentCaptureCallback callback, void* userdata) noexcept {
+  if (callback == nullptr ||
+      !(aurora::webgpu::g_graphicsConfig.surfaceConfiguration.usage & wgpu::TextureUsage::CopySrc)) {
+    return false;
+  }
+  std::lock_guard lock(aurora::g_presentCaptureMutex);
+  if (aurora::g_presentCapture.callback != nullptr) {
+    return false;
+  }
+  aurora::g_presentCapture = {.callback = callback, .userdata = userdata};
+  return true;
