+// SMS PC port patch (aurora_present_capture.patch): armed by gfx::request_present_capture,
+// taken by the next end_frame.
+struct PresentCapture {
+  gfx::PresentCaptureCallback callback = nullptr;
+  void* userdata = nullptr;
+};
+std::mutex g_presentCaptureMutex;
+PresentCapture g_presentCapture;
+
+struct PresentCaptureReadback {
+  PresentCapture request;
+  wgpu::Buffer buffer;
+  uint32_t width = 0;
+  uint32_t height = 0;
+  uint32_t bytesPerRow = 0;
+  wgpu::TextureFormat format = wgpu::TextureFormat::Undefined;
+};
+
+// Render worker, after the present blit and ImGui: copies the surface texture.
+std::shared_ptr<PresentCaptureReadback> encode_present_capture(const wgpu::CommandEncoder& encoder,
+                                                               const wgpu::Texture& texture,
+                                                               const PresentCapture& request) {
+  if (request.callback == nullptr ||
+      !(webgpu::g_graphicsConfig.surfaceConfiguration.usage & wgpu::TextureUsage::CopySrc)) {
+    return nullptr;
+  }
+  auto rb = std::make_shared<PresentCaptureReadback>();
+  rb->request = request;
+  rb->width = texture.GetWidth();
+  rb->height = texture.GetHeight();
+  rb->format = texture.GetFormat();
+  rb->bytesPerRow = (rb->width * 4 + 255) & ~255u;
+  const wgpu::BufferDescriptor bd{
+      .label = "Present capture readback",
+      .usage = wgpu::BufferUsage::MapRead | wgpu::BufferUsage::CopyDst,
+      .size = static_cast<uint64_t>(rb->bytesPerRow) * rb->height,
+  };
+  rb->buffer = g_device.CreateBuffer(&bd);
+  const wgpu::TexelCopyTextureInfo src{.texture = texture};
+  const wgpu::TexelCopyBufferInfo dst{
+      .layout = {.offset = 0, .bytesPerRow = rb->bytesPerRow, .rowsPerImage = rb->height},
+      .buffer = rb->buffer,
+  };
+  const wgpu::Extent3D size{rb->width, rb->height, 1};
+  encoder.CopyTextureToBuffer(&src, &dst, &size);
+  return rb;
+}
+
+// Render worker, after submit.
+void map_present_capture(const std::shared_ptr<PresentCaptureReadback>& rb) {
+  if (!rb) {
+    return;
+  }
+  const size_t bytes = static_cast<size_t>(rb->bytesPerRow) * rb->height;
+  rb->buffer.MapAsync(wgpu::MapMode::Read, 0, bytes, wgpu::CallbackMode::AllowSpontaneous,
+                      [rb, bytes](wgpu::MapAsyncStatus status, wgpu::StringView) {
+                        if (status == wgpu::MapAsyncStatus::Success) {
+                          const auto* data = static_cast<const uint8_t*>(rb->buffer.GetConstMappedRange(0, bytes));
+                          if (data != nullptr) {
+                            rb->request.callback(rb->request.userdata, data, rb->width, rb->height, rb->bytesPerRow,
+                                                 rb->format);
+                          }
+                          rb->buffer.Unmap();
+                        } else {
+                          Log.warn("Present capture: buffer map failed");
+                        }
+                      });
 }
