+// SMS PC port patch (aurora_display_aspect.patch).
+void set_locked_aspect(float aspect) {
+  if (aspect < 0.f || g_lockedAspect == aspect) {
+    return;
+  }
+  g_lockedAspect = aspect;
+  request_frame_buffer_resize();
+}
