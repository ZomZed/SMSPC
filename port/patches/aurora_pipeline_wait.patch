+// SMS PC port patch (aurora_pipeline_wait.patch): like get_pipeline, but a pipeline that is
+// still queued (normal or background/prewarm queue) is moved to the front of the queue and
+// waited for, so its draw is never skipped. The GameCube never drops geometry; a skipped
+// draw shows as missing objects for the first frames of a stage, or ends up in an EFB copy.
+bool wait_pipeline(PipelineRef ref, CompiledPipeline& pipeline) {
+  std::unique_lock lock{g_pipelineMutex};
+  if (!g_pipelines.contains(ref)) {
+    if (!g_hasPipelineThread || !g_pendingPipelines.contains(ref)) {
+      return false;
+    }
+    if (auto it = find_pending_pipeline(g_pipelineQueue, ref); it != g_pipelineQueue.end()) {
+      PendingPipeline pending = std::move(*it);
+      g_pipelineQueue.erase(it);
+      g_pipelineQueue.emplace_front(std::move(pending));
+    } else {
+      promote_pending_pipeline(ref, PipelinePriority::Blocking);
+    }
+    g_pipelineQueueCv.notify_one();
+    g_pipelineReadyCv.wait(lock, [=] { return g_pipelines.contains(ref) || g_pipelineThreadEnd; });
+  }
+  const auto it = g_pipelines.find(ref);
+  if (it == g_pipelines.end() || !it->second.main) {
+    return false;
+  }
+  pipeline = it->second;
+  return true;
+}
