+// SMS PC port patch (aurora_copy_filter.patch): the vertical filter of texture copies. The
+// seven coefficients weight the lines above (0, 1), at (2, 3, 4) and below (5, 6) each output
+// line, out of 64. vf == GX_FALSE is the hardware default {0, 0, 21, 22, 21, 0, 0}, i.e. no
+// filter. The anti-aliasing sample pattern has no meaning for the single-sampled EFB.
+void GXSetCopyFilter(GXBool aa, u8 sample_pattern[12][2], GXBool vf, u8 vfilter[7]) {
+  (void)aa;
+  (void)sample_pattern;
+  u32 packed = 0;
+  if (vf != GX_FALSE && vfilter != nullptr) {
+    const u32 above = vfilter[0] + vfilter[1];
+    const u32 at = vfilter[2] + vfilter[3] + vfilter[4];
+    const u32 below = vfilter[5] + vfilter[6];
+    if (above != 0 || below != 0 || at != 64) {
+      packed = std::min(above, 255u) | (std::min(at, 255u) << 8) | (std::min(below, 255u) << 16) | (1u << 24);
+    }
+  }
+  GX_WRITE_AURORA(GX_AURORA_LOAD_COPY_FILTER);
+  GX_WRITE_U32(packed);
+}
 
